```gitignore
# Compiled Python files
*.pyc
__pycache__/

# Jupyter notebooks - temporary files
*.ipynb.py

# Visualizations - images (not ignoring since they're part of the project)
# decision_boundaries.png, overfitting_analysis.png, regression_example.png, tree_structure.png are kept in repo

# Dependencies
venv/
.venv/
.env
.env.local
*.env.*

# Build artifacts
dist/
build/
target/

# Cache directories
.mypy_cache/
.pytest_cache/
.coverage
coverage/
htmlcov/

# Logs
*.log

# Editors
.vscode/
.idea/

# OS generated files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.swp
*.swo
```